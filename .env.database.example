# Branch database connection — SampleApp, Flyway, lakebase db generate-token
# Do not use platform SP credentials here.

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
LAKEBASE_ENDPOINT=projects/YOUR_PROJECT_ID/branches/BRANCH_ID/endpoints/primary

# Same App SP developers use locally (application/client id). Feature-branch CI
# transfers table ownership to this role so lakebase db migrate can DDL.
# Omit Password when LAKEBASE_USE_OAUTH_TOKEN=true.
DATABASE_URL=Host=ep-CHANGEME.database.REGION.cloud.databricks.com;Port=5432;Database=databricks_postgres;Username=<app-sp-application-id>;SSLMode=Require

LAKEBASE_DATABASE_CLIENT_ID=<app-sp-application-id>
LAKEBASE_DATABASE_CLIENT_SECRET=
LAKEBASE_APP_SP_ID=<app-sp-application-id>
LAKEBASE_USE_OAUTH_TOKEN=true

# Optional overrides (defaults shown)
# LAKEBASE_APP_SCHEMA=public          # schema whose tables/sequences grant-ddl hands to the app SP
# LAKEBASE_DATABASE_NAME=databricks_postgres
# For deployed apps prefer SSLMode=VerifyFull in DATABASE_URL (certificate + hostname check).
