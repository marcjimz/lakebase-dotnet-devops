# Lakebase lab configuration, read by the app, the lakebase CLI, and the Lakebase SCM
# VS Code extension. Copy to .env (the extension's post-checkout hook does this for you).
#
# Local auth is your own Databricks login: run `databricks auth login` once. No PAT,
# client ID, client secret, or database password is stored here.

# --- You set these ------------------------------------------------------------
LAKEBASE_PROJECT_ID=lakebase-dotnet-lab
DATABRICKS_HOST=https://fevm-real-time-mode-demo.cloud.databricks.com
# Your `databricks auth login` profile for this workspace. Find it with:
#   databricks auth profiles
# and pick a profile for this workspace's host whose Valid column is YES (check: databricks current-user me -p <profile>).
# Required when several profiles point at the same workspace; with only DATABRICKS_HOST the
# CLI can't choose and the extension reports "session does not read back as authenticated".
DATABRICKS_CONFIG_PROFILE=

# --- Branch connection: written by the Lakebase SCM extension (do not edit) ----
# Filled in on every git branch switch or Refresh Credentials. Optional: until then the app
# and Run Migrations pair the checked-out git branch with its Lakebase branch (main ->
# production) and look up the host themselves. No password is needed here.
# LAKEBASE_BRANCH_ID=
# LAKEBASE_HOST=
# LAKEBASE_ENDPOINT=primary
# DB_USERNAME=
# DATABASE_URL=            # optional fixed override (any of postgresql://, jdbc:, or Host=...;)

# --- Optional -----------------------------------------------------------------
# LAKEBASE_AUTH_MODE=databricks-cli   # default locally; `pat` uses DATABRICKS_TOKEN instead
# LAKEBASE_MAIN_BRANCH_ID=production
# LAKEBASE_ALLOW_BRANCH_DELETE=false  # lakebase platform branch delete

# --- CI/CD only: never put these in .env --------------------------------------
# The GitHub workflows authenticate as service principals. Their secrets live in the
# GitHub environments (dev|staging|production)-(platform|database); see README → GitHub setup.
#   LAKEBASE_PLATFORM_CLIENT_ID / LAKEBASE_PLATFORM_CLIENT_SECRET   (branches, roles, snapshots)
#   LAKEBASE_DATABASE_CLIENT_ID / LAKEBASE_DATABASE_CLIENT_SECRET   (Flyway + app SP)
#   LAKEBASE_DATABASE_USERNAME, LAKEBASE_PROD_ENDPOINT, LAKEBASE_APP_SP_ID
#   LAKEBASE_AUTH_TYPE=github-oidc   (secretless alternative to the client secrets)
