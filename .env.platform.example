# Lakebase control plane — branch create/delete, role assignment, promote.
# Used by: lakebase platform *
# Do not use these credentials for Postgres or SampleApp...

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
LAKEBASE_PLATFORM_CLIENT_ID=
LAKEBASE_PLATFORM_CLIENT_SECRET=

LAKEBASE_PROJECT_ID=YOUR_PROJECT_ID
LAKEBASE_MAIN_BRANCH_ID=production
LAKEBASE_STAGING_BRANCH_ID=development
LAKEBASE_DEV_GROUP=
LAKEBASE_APP_SP_ID=

# Target for: lakebase platform promote
PRODUCTION_LAKEBASE_ENDPOINT=projects/YOUR_PROJECT_ID/branches/production/endpoints/primary
PRODUCTION_DATABASE_URL=Host=ep-PROD.database.REGION.cloud.databricks.com;Port=5432;Database=databricks_postgres;Username=<app-sp-or-prod-role>;SSLMode=Require

# Branch delete is off by default
LAKEBASE_ALLOW_BRANCH_DELETE=false

# Optional overrides (defaults shown)
# LAKEBASE_APP_ROLE_ID=portal-app
# LAKEBASE_DATABASE_NAME=databricks_postgres
# LAKEBASE_ENDPOINT_WAIT_SECONDS=300
# CI only: GitHub OIDC federation instead of a client secret (job needs id-token: write)
# LAKEBASE_AUTH_TYPE=github-oidc
# DATABRICKS_TOKEN_AUDIENCE=<audience from the SP federation policy>
